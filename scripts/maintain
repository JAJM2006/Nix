#!/usr/bin/env bash

choice=$(gum choose "System Rebuild" "Garbage Collection" "Optimise Store" "Update Flake" "Exit")

case $choice in
    "System Rebuild")
        echo "🚀 Rebuilding..."
        sudo nixos-rebuild switch --flake .
        ;;
    "Garbage Collection")
        days=$(gum input --placeholder "Delete generations older than? (e.g. 7d)")
        echo "🗑️  Collecting garbage (keeping last $days)..."
        sudo nix-collect-garbage --delete-older-than "$days"
        ;;
    "Optimise Store")
        echo "🧹 Deduplicating nix store..."
        nix-store --optimise
        ;;
    "Update Flake")
        echo "🔄 Updating flake.lock..."
        nix flake update
        ;;
    "Exit")
        exit 0
        ;;
esac

gum style --foreground 212 "✨ Done!"
