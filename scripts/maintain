#!/usr/bin/env bash
# ==============================================================================
# SCRIPTS/MAINTAIN — Maintenance tasks
# ==============================================================================
# Run from anywhere. Gives you a menu for common upkeep operations.
# ==============================================================================

set -e

# Always operate from the repo root, regardless of where this script is called from.
cd "$(dirname "$0")/.."

# ==============================================================================
# GUM BOOTSTRAP
# ==============================================================================
# gum makes the prompts pretty. If it somehow isn't on PATH (e.g. you're
# running this before the first rebuild has put it in your environment),
# drop into a temporary nix-shell that has it.
# ==============================================================================

if ! command -v gum &>/dev/null; then
    echo ""
    echo "  'gum' not found — launching a temporary nix-shell that has it."
    echo ""
    exec nix-shell -p gum --run "bash $0 $*"
fi

# ==============================================================================
# MENU
# ==============================================================================

choice=$(gum choose "System Rebuild" "Garbage Collection" "Optimise Store" "Update Flake" "Exit")

case $choice in
    "System Rebuild")
        echo "🚀 Rebuilding..."
        sudo nixos-rebuild switch --flake ".#$(hostname)"
        ;;
    "Garbage Collection")
        days=$(gum input --placeholder "Delete generations older than? (e.g. 7d)")
        echo "🗑️  Collecting garbage (keeping last $days)..."
        sudo nix-collect-garbage --delete-older-than "$days"
        ;;
    "Optimise Store")
        echo "🧹 Deduplicating nix store..."
        nix-store --optimise
        ;;
    "Update Flake")
        echo "🔄 Updating flake.lock..."
        nix flake update
        ;;
    "Exit")
        exit 0
        ;;
esac

gum style --foreground 212 "✨ Done!"
